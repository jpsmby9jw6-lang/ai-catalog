    "url": "https://github.com/example/ai-catalog-spec"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "js-yaml": "^5.2.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "preferGlobal": true
}
